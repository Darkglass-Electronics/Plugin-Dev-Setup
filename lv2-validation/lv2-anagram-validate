# Utilities

class NS():
    def NS(self):
        pass

    def __init__(self, world, base):
        self.world = world
        self.base = base
        self._cache = {}

    def __getattr__(self, attr):
        if attr.endswith("_"):
            attr = attr[:-1]
        if attr not in self._cache:
            self._cache[attr] = self.world.new_uri(self.base + attr)
        return self._cache[attr]


def validate_plugin_binary(world, plugin, target_dir):
    bintestresults = {
        "errors": [],
        "warnings": [],
        "pedantic": [],
    }

    lib_path = Path(urlparse(str(plugin.get_library_uri())).path)
    bundle_path = Path(urlparse(str(plugin.get_bundle_uri())).path)
    plugin_uri = str(plugin.get_uri())

    def is_pablito():
        try:
            with open("/proc/device-tree/model") as f:
                return "Pablito" in f.read()
        except OSError:
            return False

    def get_binary_format(path):
        if is_pablito():
            return "aarch64"
        out = subprocess.run(["file", str(path)], capture_output=True, text=True).stdout
        if "x86" in out:
            return "x86"
        if "aarch64" in out:
            return "aarch64"
        return None

    plugin_format = get_binary_format(lib_path)
    host_format   = get_binary_format("/usr/bin/tiny-host")

    runcommand = ["tiny-host", f"{bundle_path}/", plugin_uri]
    using_valgrind = False

    if plugin_format == host_format:
        if shutil.which("valgrind"):
            runcommand = [
                "valgrind",
                "--error-exitcode=99", #Use specific exitcode for valgrind errors
                "--leak-check=full",
                "--show-leak-kinds=definite,indirect",
            ] + runcommand
            using_valgrind = True
    elif plugin_format == "aarch64" and shutil.which("qemu-aarch64"):
        runcommand = ["qemu-aarch64", "-L", f"{target_dir}/target/usr/"] + runcommand
    else:
        bintestresults["warnings"].append(f"cannot validate: plugin is {plugin_format}, host is {host_format}, no emulator available")
        return bintestresults

    result = subprocess.run(runcommand, capture_output=True, text=True)

    def hash_uri(s: str):
        h = 0xcbf29ce484222325
        for c in s.encode("utf-8"):
            h ^= c
            h = (h * 0x100000001b3) & 0xFFFFFFFFFFFFFFFF
        return f"{h:016x}"

    def parse_result(result_type):
        resultsfile = Path(f"/tmp/{hash_uri(plugin_uri)}_tinyhost_testresult_{result_type}.txt")
        file_notes = ""
        if resultsfile.exists():
            try:
                file_notes = resultsfile.read_text().strip()
            finally:
                resultsfile.unlink(missing_ok=True)
        return file_notes

    err_msg = parse_result("err")
    warn_msg = parse_result("warn")
    pedan_msg = parse_result("pedantic")

    rc = result.returncode
    if rc == 99:
        bintestresults["errors"].append(f"valgrind detected memory issues while running plugin in tiny-host:\n{result.stderr or result.stdout}\n")
    elif rc >= 128:
        sig = rc - 128
        bintestresults["errors"].append(f"tiny-host was killed by signal {sig} (likely crashed inside plugin code)")
    elif rc != 0:
        bintestresults["errors"].append(f"tiny-host exited with code {rc}:\n{result.stderr or result.stdout}\n")

    if err_msg:
        bintestresults["errors"].append(err_msg)
    if warn_msg:
        bintestresults["warnings"].append(warn_msg)
    if pedan_msg:
        bintestresults["pedantic"].append(pedan_msg)

    return bintestresults

def validate_plugin_ttl_with_sord(plugin_bundle_path, target_dir):

    lv2_path_regex = f"{target_dir}/target/usr/lib/lv2"
    lv2_path = glob.glob(lv2_path_regex)

    if len(lv2_path) == 0:
        print("error, could not find LV2 path")
        sys.exit(1)
    elif len(lv2_path) > 1:
        print("error, found multiple LV2 paths")
        sys.exit(1)
    else:
        lv2_path = lv2_path[0]

    # collect extension TTLs
    spec_ttls = glob.glob(os.path.join(lv2_path, "**/*.ttl"), recursive=True)

    # collect plugin TTLs
    plugin_ttls = glob.glob(os.path.join(plugin_bundle_path, "*.ttl"))

    result = subprocess.run(
        ["sord_validate"] + spec_ttls + plugin_ttls,
        capture_output=True,
        text=True
    )

    output = (result.stderr or "") + (result.stdout or "")
    output = output.strip()
    return output or None

def is_integer(string):
    return string.strip().lstrip("-+").isdigit()

def first_or(nodes, fallback):
    first = next(iter(nodes), None)
    return first if first is not None else fallback

def int_first_or(nodes):
    first = next(iter(nodes), None)
    return int(first) if first is not None else 0

def str_first_or(nodes):
    if nodes is None:
        return ""
    first = next(iter(nodes), None)
    return str(first) if first is not None else ""

def str_or(node):
    return str(node) if node is not None else ""

def iter_compat(value, conv = str):
    data  = []
    viter = iter(value)
    value = next(viter, None)
    while value is not None:
        data.append(conv(value))
        value = next(viter, None)
    return data

def get_short_port_name(portName):
    if len(portName) <= 16:
        return portName

    portName = portName.split("/",1)[0].split(" (",1)[0].split(" [",1)[0].strip()

    # cut stuff if too big
    if len(portName) > 16:
        portName = portName[0] + portName[1:].replace("a","").replace("e","").replace("i","").replace("o","").replace("u","")

        if len(portName) > 16:
            portName = portName[:16]

    return portName.strip()

