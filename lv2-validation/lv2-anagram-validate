# get_plugins_info

# Get plugin-related info from a list of lv2 bundles
# @a bundles is a list of strings, consisting of directories in the filesystem (absolute pathnames).
def get_plugins_info(bundles):
    # Create our own unique lilv world
    # We'll load the selected bundles and get all plugins from it
    world = lilv.World()
    # this is needed when loading specific bundles instead of load_all
    world.load_specifications()
    world.load_plugin_classes()

    # Check if we are running in docker DEBUG image
    bashrccontent = subprocess.run(
        ["cat", f"{Path.home()}/.bashrc"],
        capture_output=True,
        text=True,
    )
    anagram_target_dir = "darkglass-anagram"
    if "darkglass-anagram-debug" in bashrccontent.stdout:
        anagram_target_dir += "-debug"

    # Find dir for LV2 extensions
    modworkdir = os.getenv("WORKDIR", f"{Path.home()}/mod-workdir")
    target_dir = f"{modworkdir}/{anagram_target_dir}"

    sord_notes_by_bundle = {}

    # load all bundles
    if len(bundles) == 0:
        world.load_all()
    else:
        for bundle in bundles:
            notes = validate_plugin_ttl_with_sord(bundle, target_dir)
            bundle_abs = os.path.abspath(bundle).rstrip(os.sep)
            sord_notes_by_bundle[bundle_abs] = notes

            # lilv wants the last character as the separator
            bundle_for_lilv = bundle_abs + os.sep
            # convert bundle string into a lilv node
            bundlenode = world.new_file_uri(None, bundle_for_lilv)
            # load the bundle
            world.load_bundle(bundlenode)

    # get all plugins available in the selected bundles
    plugins = world.get_all_plugins()
    if len(plugins) == 0:
        return []

    def conv(plugin):
        entry = get_plugin_info(world, plugin, target_dir)

        # map this plugin back to its bundle, to be able to add sord's notes
        bundle_uri = str(plugin.get_bundle_uri())
        bundle_path = urllib.parse.urlparse(bundle_uri).path.rstrip(os.sep)

        notes = sord_notes_by_bundle.get(bundle_path)
        if notes:
            entry['sord_validate_notes'] = notes

        return entry

    return iter_compat(plugins, conv)

# ------------------------------------------------------------------------------------------------------------

def usage(exit_code=1):
    print(f'Usage: {sys.argv[0]} [/path/to/lv2/bundle] <extra-options>')
    print()
    print('Extra options:')
    print('  --no-pedantic    Skip pedantic messages')
    print('  --no-warnings    Skip warnings')
    print('  --verbose        Always show all plugins, good ones too')

# ------------------------------------------------------------------------------------------------------------

def main():
    if '-h' in sys.argv or '--help' in sys.argv:
        usage()
        sys.exit(0)

    warnings = True
    pedantic = True
    verbose = False

    bundles = []
    for arg in sys.argv[1:]:
        if arg == '--':
            break
        if '--no-pedantic' in sys.argv:
            pedantic = False
        elif '--no-warnings' in sys.argv:
            warnings = pedantic = False
        elif '--verbose' in sys.argv:
            verbose = True
        elif arg.startswith('--'):
            usage()
            sys.exit(1)
        else:
            if not os.path.isdir(arg):
                usage()
                sys.exit(1)

            bundles.append(arg)

    for i in get_plugins_info(bundles):
        if not verbose and not i['errors'] and (not warnings or not i['warnings']) and (not pedantic or not i['pedantic']):
            continue

        print(f'------------ {i["uri"]}')
        if warnings and not (i['errors'] or i['warnings']):
            print('No errors or warnings')

        else:
            if i['errors']:
                print('Errors:')
                for msg in i['errors']:
                    print(f'  - {msg}')
            else:
                print('No errors')

            if warnings:
                if i['warnings']:
                    print('Warnings:')
                    for msg in i['warnings']:
                        print(f'  - {msg}')
                else:
                    print('No warnings')

        if pedantic:
            if i['pedantic']:
                print('Pedantic info:')
                for msg in i['pedantic']:
                    print(f'  - {msg}')

        print()

    if generalwarnings:
        print('General warnings:')
        for msg in generalwarnings:
            print(f'  - {msg}')

    print()

# ------------------------------------------------------------------------------------------------------------

if __name__ == '__main__':
    main()

