def get_bundle_dirname(bundleuri):
    world = lilv.World()
    bundle = str(world.new_uri(bundleuri).get_path())

    if not os.path.exists(bundle):
        raise IOError(bundleuri)

    if os.path.isfile(bundle):
        bundle = os.path.dirname(bundle)

    return bundle

